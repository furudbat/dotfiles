#!/usr/bin/env bash

# ============================================================
# Variables
# ============================================================
THEME_COLOR=""
EFFECT=""
NOTIFICATIONS=false
MONITOR_OUTPUT=""
CACHE_FOLDER="$HOME/.cache/ml4w/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
DEFAULT_WALLPAPER="$HOME/.config/ml4w/wallpapers/default.jpg"
BLURRED_WALLPAPER="$CACHE_FOLDER/blurred_wallpaper.png"
SQUARE_WALLPAPER="$CACHE_FOLDER/square_wallpaper.png"
RASI_FILE="$CACHE_FOLDER/current_wallpaper.rasi"
SETTINGS_BLUR="$HOME/.config/ml4w/settings/blur.sh"
SETTINGS_WALLPAPER_FOLDER="$HOME/.config/ml4w/settings/wallpaper-folder"
SETTINGS_WALLPAPER_EFFECT="$HOME/.config/ml4w/settings/wallpaper-effect"
SETTINGS_TRANSITION_EFFECT=$(cat $HOME/.config/ml4w/settings/wallpaper-transition-effect)
SETTINGS_PRIMARY_MONITOR="$HOME/.config/ml4w/settings/wallpaper-primary-monitor"
BLUR=$(cat $SETTINGS_BLUR)
SETTINGS_THEME_COLOR="$HOME/.config/ml4w/settings/matugen-color"


# ============================================================
# Logging
# ============================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# ============================================================
# Functions
# ============================================================

show_help() {
    echo "Usage: ml4w-matugen THEME_COLOR [OPTIONS]"
    echo ""
    echo "Core Parameters:"
    echo "  THEME_COLOR          Single source color."
    echo ""
    echo "Optional Parameters:"
    echo "  --notifications        Enable desktop notifications."
    echo "  --monitor              Specify which input to apply wallpaper change (default applies to all outputs)"
    echo "  --help                 Show this help message and exit."
    echo "  --monitor PRIMARY      Update Theme based on PRIMARY monitor."
}

send_notification() {
    [ "$NOTIFICATIONS" = true ] || return
    notify-send -a "ml4w-wallpaper" -i "preferences-desktop-wallpaper-symbolic" "$1" "$2"
}

run_matugen() {
    local theme_pref
    theme_pref=$(grep -E '^gtk-application-prefer-dark-theme=' "$HOME/.config/gtk-3.0/settings.ini" | awk -F'=' '{print $2}')
    local mode="light"
    case "$theme_pref" in
        1|true|TRUE|yes|YES)
            mode="dark"
            ;;
    esac

    local bin="matugen"
    [ -f "$HOME/.cargo/bin/matugen" ] && bin="$HOME/.cargo/bin/matugen"
    [ -f "$HOME/.local/bin/matugen" ] && bin="$HOME/.local/bin/matugen"

    info "Running matugen in $mode mode"
    "$bin" color hex "$THEME_COLOR" -m "$mode"
    info "Matugen updated"

    echo "$THEME_COLOR" > $SETTINGS_THEME_COLOR
}

reload_waybar() {
    if pgrep -x waybar >/dev/null; then
        pkill -SIGUSR2 waybar
        info "Waybar reloaded"
    else
        nohup bash -c "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1 &
        disown
        info "Waybar launched"
    fi
}

reload_nwg_dock() {
    nohup bash -c "$HOME/.config/nwg-dock-hyprland/launch.sh" >/dev/null 2>&1 &
    disown
    info "nwg-dock-hyprland reloaded"
}

reload_quickshell() {
    if pgrep -x qs >/dev/null; then
        qs ipc call theme-manager reload
        qs -p "$HOME/.local/share/ml4w-dotfiles-settings/quickshell" ipc call theme-manager reload
        info "Quickshell theme updated"
    else
        warn "Quickshell not running, skipping theme reload"
    fi
}

reload_pywalfox() {
    type pywalfox >/dev/null 2>&1 || return
    pywalfox update
    info "Pywalfox updated"
}

reload_swaync() {
    sleep 0.1
    swaync-client -rs
    info "SwayNC refreshed"
}

# ============================================================
# Parameter Parsing
# ============================================================
[[ $# -eq 0 ]] && { show_help; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --monitor)
            TARGET_MONITOR="$2"
            shift 2
            ;;
        --notifications)
            NOTIFICATIONS=true; shift ;;
        --monitor)
            MONITOR_OUTPUT="$2"; shift 2 ;;
        --help)
            show_help; exit 0 ;;
        -*)
            error "Unknown option: $1"; show_help; exit 1 ;;
        *)
            if [[ -z "$THEME_COLOR" ]]; then
                THEME_COLOR="$1"
            else
                error "Multiple colors provided -> $1"; exit 1
            fi
            shift ;;
    esac
done

if [ -n "$TARGET_MONITOR" ] && [ -f "$SETTINGS_PRIMARY_MONITOR" ]; then
    PRIMARY_MONITOR=$(cat "$SETTINGS_PRIMARY_MONITOR")
    if [ "$PRIMARY_MONITOR" != "$TARGET_MONITOR" ]; then
        CACHE_FILE="$CACHE_FOLDER/current_wallpaper_$TARGET_MONITOR"
        BLURRED_WALLPAPER="$CACHE_FOLDER/blurred_wallpaper_$TARGET_MONITOR.png"
        SQUARE_WALLPAPER="$CACHE_FOLDER/square_wallpaper_$TARGET_MONITOR.png"
        RASI_FILE="$CACHE_FOLDER/current_wallpaper_$TARGET_MONITOR.rasi"
    fi
fi

# ============================================================
# Validation
# ============================================================

run_matugen
reload_waybar
reload_nwg_dock
reload_quickshell
reload_pywalfox
reload_swaync

info "Done"
