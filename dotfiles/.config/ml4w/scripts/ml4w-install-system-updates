#!/usr/bin/env bash
#    ____         __       ____               __     __
#   /  _/__  ___ / /____ _/ / / __ _____  ___/ /__ _/ /____ ___
#  _/ // _ \(_-</ __/ _ `/ / / / // / _ \/ _  / _ `/ __/ -_|_-<
# /___/_//_/___/\__/\_,_/_/_/  \_,_/ .__/\_,_/\_,_/\__/\__/___/
#                                 /_/
#

# show packages NEWER then X days
UPDATE_AGE_DAYS=7

# Check if command exists
_checkCommandExists() {
    command -v "$1" &> /dev/null
}

_isInstalled() {
    package="$1"
    case $install_platform in
        arch)
            check="$($aur_helper -Qs --color always "${package}" | grep "local" | grep "${package} ")"
            ;;
        fedora)
            check="$(dnf repoquery --quiet --installed ""${package}*"")"
            ;;
        *) ;;
    esac

    if [ -n "${check}" ]; then
        echo 0 #'0' means 'true' in Bash
        return #true
    fi
    echo 1 #'1' means 'false' in Bash
    return #false
}

# ------------------------------------------------------
# Confirm Start
# ------------------------------------------------------

sleep 1
clear
figlet -f smslant "Updates"
echo
primarycolor=$(cat ~/.config/ml4w/colors/primary)
onsurfacecolor=$(cat ~/.config/ml4w/colors/onsurface)
onprimarycolor=$(cat ~/.config/ml4w/colors/onprimary)
if gum confirm --selected.background=$primarycolor --selected.foreground=$onprimarycolor --prompt.foreground=$onsurfacecolor "DO YOU WANT TO START THE UPDATE NOW?"; then
    echo
    echo ":: Update started..."
elif [ $? -eq 130 ]; then
    exit 130
else
    echo
    echo ":: Update canceled."
    exit
fi

# ----------------------------------------------------- 
# Install update
# ----------------------------------------------------- 

# Arch
if _checkCommandExists "pacman"; then
    shelly_installed="false"
    yay_installed="false"
    paru_installed="false"
    if _checkCommandExists "shelly"; then
        shelly_installed="true"
    fi
    if _checkCommandExists "yay"; then
        yay_installed="true"
    fi
    if _checkCommandExists "paru"; then
        paru_installed="true"
    fi

    echo ":: Checking package update age..."

    warning_found=0
    updates_found=0
    # Official repo updates
    while read -r pkg oldver newver; do
        updates_found=1

        pkg_clean="${pkg#*/}"

        pkg_date=$(expac -S '%b' "$pkg_clean" 2>/dev/null)
        [[ -z "$pkg_date" ]] && continue

        pkg_epoch=$(date -d "$pkg_date" +%s 2>/dev/null)
        [[ -z "$pkg_epoch" ]] && continue

        age_days=$(( ($(date +%s) - pkg_epoch) / 86400 ))

        if (( age_days <= UPDATE_AGE_DAYS )); then
            echo "⚠️ WARNING: repo update $pkg_clean is only $age_days days old"
            warning_found=1
        fi
    done < <(checkupdates 2>/dev/null)

    # AUR updates
    if [[ "$yay_installed" == "true" || "$paru_installed" == "true" ]]; then
        while read -r pkg oldver newver; do
            updates_found=1

            lastmod=$(curl -fsS \
                "https://aur.archlinux.org/rpc/v5/info?arg[]=$pkg" |
                jq -r '.results[0].LastModified')

            [[ -z "$lastmod" || "$lastmod" == "null" ]] && continue

            age_days=$(( ($(date +%s) - lastmod) / 86400 ))

            if (( age_days <= UPDATE_AGE_DAYS )); then
                echo "⚠️ WARNING: AUR update $pkg is only $age_days days old"
                warning_found=1
            fi
        done < <(
            if [[ "$paru_installed" == "true" ]]; then
                paru -Qua
            else
                yay -Qua
            fi
        )
    fi

    if [[ $updates_found -eq 0 ]]; then
        echo ":: No updates available"
    elif [[ $warning_found -eq 0 ]]; then
        echo ":: All available updates are older than $UPDATE_AGE_DAYS days"
    else
        echo
        echo "⚠️ Some updates are newer than $UPDATE_AGE_DAYS days."
        echo "⚠️ Consider waiting before upgrading."
        echo
    fi

    if [[ $shelly_installed == "true" ]]; then
        echo ":: Arch News"
        shelly news || true
        echo
    fi

    if [[ $shelly_installed == "true" ]]; then
        echo ":: Checking for system updates..."
        shelly list-updates
        echo
        
        echo ":: Running Shelly system updater..."
        shelly upgrade
    elif _checkCommandExists "cachyos-hello"; then
        echo ":: Running CachyOS system updater..."
        cachyos-hello fix update-system
    elif [[ $yay_installed == "true" ]] && [[ $paru_installed == "false" ]]; then
        yay
    elif [[ $yay_installed == "false" ]] && [[ $paru_installed == "true" ]]; then
        paru -Syu --noconfirm
    else
        yay
    fi
# Fedora
elif _checkCommandExists "dnf"; then
    sudo dnf upgrade
else
    echo ":: ERROR - Platform not supported"
    echo "Press [ENTER] to close."
    read
fi
echo

# Flatpak
echo ":: Searching for Flatpak updates..."
if _checkCommandExists "shelly"; then
    shelly flatpak upgrade
else
    flatpak update
fi
echo

# Reload Waybar
pkill -RTMIN+1 waybar

# Finishing
echo ":: Update complete! Press [ENTER] to close."
read
